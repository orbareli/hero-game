# ── Backend ngrok URLs ────────────────────────────────────────────────────────
# Run: ngrok http 8000
# Then paste the https URL below (no trailing slash)

VITE_API_URL=https://d4d4-2a06-c701-42fd-de00-91ec-3f0e-1332-35e7.ngrok-free.app
VITE_WS_URL=wss://d4d4-2a06-c701-42fd-de00-91ec-3f0e-1332-35e7.ngrok-free.app

# ── How to use ────────────────────────────────────────────────────────────────
# 1. Run your backend:       uvicorn main:app --port 8000
# 2. Run ngrok:              ngrok http 8000
# 3. Copy the https URL and paste it above (same URL for both vars, just wss:// for WS)
# 4. Run your frontend:      npm run dev
# 5. Share the frontend ngrok URL with your phone
#
# Example:
#   VITE_API_URL=https://abc123.ngrok-free.app
#   VITE_WS_URL=wss://abc123.ngrok-free.app
#
# When running locally (no .env set), everything falls back to localhost:8000
